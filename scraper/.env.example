# PostgreSQL connection (defaults match ../docker-compose.yaml)
DB_HOST=localhost
DB_PORT=6001
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=mysecretpassword

# Firecrawl (stage 4). Get a key at https://www.firecrawl.dev/app/api-keys; without
# one the API still works, with much lower rate limits.
FIRECRAWL_API_KEY=
# Change only for a self-hosted Firecrawl instance.
FIRECRAWL_API_URL=https://api.firecrawl.dev
# Parallel scrape requests; keep it within your plan's concurrency limit.
FIRECRAWL_CONCURRENCY=2
